+	vpcie3v3-supply = <&vcc3v3_pcie>;
+	reset-gpios = <&gpio2 RK_PD6 GPIO_ACTIVE_HIGH>;
+	status = "okay";
+};
+
+&pcie30phy {
+	u-boot,dm-pre-reloc;
+	status = "okay";
+};
+
+&pinctrl {
+	u-boot,dm-pre-reloc;
+	status = "okay";
+};
+
+&gpio0 {
+	u-boot,dm-spl;
+};
+
+&gpio1 {
+	u-boot,dm-spl;
+};
+
+&gpio2 {
+	u-boot,dm-pre-reloc;
+};
+
+&pcfg_pull_none_drv_level_1 {
+	u-boot,dm-pre-reloc;
+};
+
+&pcfg_pull_none_drv_level_2 {
+	u-boot,dm-pre-reloc;
+};
+
+
+&pcfg_pull_up_drv_level_1 {
+	u-boot,dm-spl;
+};
+
+&pcfg_pull_up_drv_level_2 {
+	u-boot,dm-spl;
+};
+
+&pcfg_pull_up {
+	u-boot,dm-spl;
+};
+
+&pcfg_pull_none {
+	u-boot,dm-pre-reloc;
+};
+
+&secure_otp {
+	u-boot,dm-spl;
+};
+
+&wdt {
+	u-boot,dm-pre-reloc;
+	status = "okay";
+};
+
+&sata1 {
