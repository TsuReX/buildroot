/dts-v1/;
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/leds/common.h>
#include <dt-bindings/pinctrl/rockchip.h>
#include "rk3568.dtsi"

#include "ethernet.dtsi"
#include "usb.dtsi"
//#include "wireless.dtsi"
//#include "audio.dtsi"
//#include "video.dtsi"

/ {
	compatible = "incarnet,mc01", "rockchip,rk3568";
    
	model = "Incarnet-MC01";

	aliases {
		ethernet0 = &gmac0;
		ethernet1 = &gmac1;
        mmc0 = &sdhci;
		mmc1 = &sdmmc0;
	};

	chosen: chosen {
		bootargs = "earlycon=uart8250,mmio32,0xfe660000 console=ttyFIQ0 root=/dev/mmcblk1p2 rootfstype=ext4 ro rootwait";
	};

	/*
		UART2_TX -> DD3 -> XS1
		UART2_RX <- DD3 <- XS1
	*/
	fiq-debugger {
		compatible = "rockchip,fiq-debugger";
		rockchip,serial-id = <2>;
		rockchip,wake-irq = <0>;
		/* If enable uart uses irq instead of fiq */
		rockchip,irq-mode-enable = <1>;
		rockchip,baudrate = <1500000>;  /* Only 115200 and 1500000 */
		interrupts = <GIC_SPI 252 IRQ_TYPE_LEVEL_LOW>;
		pinctrl-names = "default";
		pinctrl-0 = <&uart2m0_xfer>;
		status = "okay";
	};

	// DA1
	//12V
	da1_12v: da1_12v {
		compatible = "regulator-fixed";
		regulator-name = "da1_12v";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <12000000>;
		regulator-max-microvolt = <12000000>;
	};

	// DA3
	// +3.3V_PMIC
	da3_3v3_pmic: da3_3v3_pmic {
		compatible = "regulator-fixed";
		regulator-name = "da3_3v3_pmic";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		vin-supply = <&da1_12v>;
	};

	// DA4
	// 5V
	da4_5v: da4_5v {
		compatible = "regulator-fixed";
		regulator-name = "da4_5v";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		vin-supply = <&da1_12v>;
	};
};

&cpu0 {
	cpu-supply = <&da6_1v_vdd_cpu>;
};

&cpu1 {
	cpu-supply = <&da6_1v_vdd_cpu>;
};

&cpu2 {
	cpu-supply = <&da6_1v_vdd_cpu>;
};

&cpu3 {
	cpu-supply = <&da6_1v_vdd_cpu>;
};

/*
 *	There are 10 independent IO domains in RK3566/RK3568, including PMUIO[0:2] and VCCIO[1:7].
 *	1/ PMUIO0 and PMUIO1 are fixed-level power domains which cannot be configured;
 *	2/ PMUIO2 and VCCIO1,VCCIO[3:7] domains require that their hardware power supply voltages
 *		must be consistent with the software configuration correspondingly
 *		a/ When the hardware IO level is connected to 1.8V, the software voltage configuration
 *			should also be configured to 1.8V accordingly;
 *		b/ When the hardware IO level is connected to 3.3V, the software voltage configuration
 *			should also be configured to 3.3V accordingly;
 *	3/ VCCIO2 voltage control selection (0xFDC20140)
 *	BIT[0]: 0x0: from GPIO_0A7 (default)
 *	BIT[0]: 0x1: from GRF
 *	Default is determined by Pin FLASH_VOL_SEL/GPIO0_A7:
 *	L:VCCIO2 must supply 3.3V
 *	H:VCCIO2 must supply 1.8V
 */
&pmu_io_domains {
	pmuio1-supply = <&da8_3v3_vcc_pmu>;
	pmuio2-supply = <&da8_3v3_vcc_pmu>;
	vccio1-supply = <&da8_3v3_vccio_acodec>;
	vccio2-supply = <&da8_1v8_vcc>;
	vccio3-supply = <&da8_3v3_vccio_sd>;
	vccio4-supply = <&da8_1v8_vcc>;
	vccio5-supply = <&da8_3v3_vcc>;
	vccio6-supply = <&da8_1v8_vcc>;
	vccio7-supply = <&da8_3v3_vcc>;
	status = "okay";
};

/* SDMMC0 - X21 */
&sdmmc0 {
	max-frequency = <50000000>;
	supports-sd;
	bus-width = <4>;
	cap-mmc-highspeed;
	cap-sd-highspeed;
	disable-wp;
	sd-uhs-sdr104;
	vmmc-supply = <&da8_3v3_vcc_sd>;
	vqmmc-supply = <&da8_3v3_vccio_sd>;
	pinctrl-names = "default";
	pinctrl-0 = <&sdmmc0_bus4 &sdmmc0_clk &sdmmc0_cmd &sdmmc0_det>;
	status = "okay";
};

&i2c0 {
	pinctrl-0 = <&i2c0_xfer>;
	pinctrl-names = "default";

	status = "okay";

	// DA6
	// +1V_VDD_CPU
	da6_1v_vdd_cpu: regulator@1c {
		compatible = "tcs,tcs452x";
		reg = <0x1c>;
		fcs,suspend-voltage-selector = <1>;
		regulator-name = "da6_1v_vdd_cpu";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <800000>;
		regulator-max-microvolt = <1150000>;
		regulator-ramp-delay = <2300>;
		vin-supply = <&da4_5v>;

		regulator-state-mem {
			regulator-off-in-suspend;
		};
	};

	// DA8
	rk809: pmic@20 {
		compatible = "rockchip,rk809";
		reg = <0x20>;
		interrupt-parent = <&gpio0>;
/*
		PMIC_INT_
*/
		interrupts = <RK_PA3 IRQ_TYPE_LEVEL_LOW>;
		rockchip,system-power-controller;
		wakeup-source;
		#clock-cells = <1>;

		clock-names = "mclk";

		vcc1-supply = <&da3_3v3_pmic>;
		vcc2-supply = <&da3_3v3_pmic>;
		vcc3-supply = <&da3_3v3_pmic>;
		vcc4-supply = <&da3_3v3_pmic>;
		vcc5-supply = <&da3_3v3_pmic>;
		vcc6-supply = <&da3_3v3_pmic>;
		vcc7-supply = <&da3_3v3_pmic>;
		vcc8-supply = <&da3_3v3_pmic>;
		vcc9-supply = <&da3_3v3_pmic>;

		regulators {
			// +0.9_VDD_LOGIC
			da8_0v9_vdd_logic: DCDC_REG1 {
				regulator-name = "da8_0v9_vdd_logic";
				regulator-always-on;
				regulator-boot-on;
				regulator-init-microvolt = <900000>;
				regulator-initial-mode = <0x2>;
				regulator-min-microvolt = <500000>;
				regulator-max-microvolt = <1350000>;
				regulator-ramp-delay = <6001>;

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			// +0.9_VDD_GPU
			da8_0v9_vdd_gpu: DCDC_REG2 {
				regulator-name = "da8_0v9_vdd_gpu";
				regulator-always-on;
				regulator-init-microvolt = <900000>;
				regulator-initial-mode = <0x2>;
				regulator-min-microvolt = <500000>;
				regulator-max-microvolt = <1350000>;
				regulator-ramp-delay = <6001>;

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			// +1.1V_VCC_DDR
			da8_1v1_vcc_ddr: DCDC_REG3 {
				regulator-name = "da8_1v1_vcc_ddr";
				regulator-always-on;
				regulator-boot-on;
				regulator-initial-mode = <0x2>;

				regulator-state-mem {
					regulator-on-in-suspend;
				};
			};

			// +0.9_VDD_NPU
			da8_0v9_vdd_npu: DCDC_REG4 {
				regulator-name = "da8_0v9_vdd_npu";
				regulator-init-microvolt = <900000>;
				regulator-initial-mode = <0x2>;
				regulator-min-microvolt = <500000>;
				regulator-max-microvolt = <1350000>;
				regulator-ramp-delay = <6001>;

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			// +1.8_VCC
			da8_1v8_vcc: DCDC_REG5 {
				regulator-name = "da8_1v8_vcc";
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			// +0.9V_VDDA_IMAGE
			da8_0v9_vdda_image: LDO_REG1 {
				regulator-boot-on;
				regulator-always-on;
				regulator-min-microvolt = <900000>;
				regulator-max-microvolt = <900000>;
				regulator-name = "da8_0v9_vdda_image";
				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			// +0.9V_VDDA
			da8_0v9_vdda: LDO_REG2 {
				regulator-name = "da8_0v9_vdda";
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <900000>;
				regulator-max-microvolt = <900000>;

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			// +0.9V_VDDA_PMU
			da8_0v9_vdda_pmu: LDO_REG3 {
				regulator-name = "da8_0v9_vdda_pmu";
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <900000>;
				regulator-max-microvolt = <900000>;

				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <900000>;
				};
			};

			// +3.3V_VCCIO_ACODEC
			da8_3v3_vccio_acodec: LDO_REG4 {
				regulator-name = "da8_3v3_vccio_acodec";
				regulator-always-on;
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			// +3.3V_VCCIO_SD
			da8_3v3_vccio_sd: LDO_REG5 {
				regulator-name = "da8_3v3_vccio_sd";
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <3300000>;

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			// +3.3V_VCC_PMU
			da8_3v3_vcc_pmu: LDO_REG6 {
				regulator-name = "da8_3v3_vcc_pmu";
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;

				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <3300000>;
				};
			};

			// +1.8V_VCCA
			da8_1v8_vcca: LDO_REG7 {
				regulator-name = "da8_1v8_vcca";
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			// +1.8V_VCCA_PMU
			da8_1v8_vcca_pmu: LDO_REG8 {
				regulator-name = "da8_1v8_vcca_pmu";
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;

				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <1800000>;
				};
			};

			// +1.8V_VCCA_IMAGE
			da8_1v8_vcca_image: LDO_REG9 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-name = "da8_1v8_vcca_image";
				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			// +3.3V_VCC
			da8_3v3_vcc: SWITCH_REG1 {
				regulator-name = "da8_3v3_vcc";
				regulator-always-on;
				regulator-boot-on;

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			// +3.3V_VCC_SD
			da8_3v3_vcc_sd: SWITCH_REG2 {
				regulator-name = "da8_3v3_vcc_sd";
				regulator-always-on;
				regulator-boot-on;
				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};
		};

	};
};

&i2c1 {
	pinctrl-0 = <&i2c1_xfer>;
	pinctrl-names = "default";
	status = "okay";
};

&i2c3 {
	pinctrl-0 = <&i2c3m0_xfer>;
	pinctrl-names = "default";
	status = "okay";
};

&uart0 {
/*
  UART0_TX -> TP17
  UART0_RX <- TP16
*/
  pinctrl-0 = <&uart0_xfer>;
  pinctrl-names = "default";
  status = "okay";
};


&uart8 {
/*
	UART8_TX -> DD8
	UART8_RX <- DD8
*/
	pinctrl-0 = <&uart8m1_xfer>;
	pinctrl-names = "default";
	status = "disabled";
};

&uart9 {
/*
	UART9_TX -> TP29 -> DD11 -> XT1
	UART9_RX <- TP31 <- DD11 <- XT1
*/
	pinctrl-0 = <&uart9m1_xfer>;
	pinctrl-names = "default";
	status = "okay";
};

&rkvdec {
	vdec-supply = <&da8_0v9_vdd_logic>;
	status = "disabled";
};

&pinctrl {
	pmic {
		pmic_int_pin: pmic-int-pin {
			// PMIC_INT_
			rockchip,pins = <0 RK_PA3 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};
};
