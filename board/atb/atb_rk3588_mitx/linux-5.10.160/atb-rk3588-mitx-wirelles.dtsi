
#if defined(ATB_MUX_WIFI)

/ {
	wifi_pwrseq: wifi-pwrseq {
		compatible = "mmc-pwrseq-simple";
		pinctrl-names = "default";
		pinctrl-0 = <&wlan_en_pin>;

		/* Toggle WIFI_ENABLE to reset the chip. */
		reset-gpios = <&gpio4 RK_PA5 GPIO_ACTIVE_LOW>;
	};
};

&sdmmc {
	// WiFi & BT combo module Fn-Link FG6233ASRB-01 / Fn-Link 8223A-SR
	mmc-pwrseq = <&wifi_pwrseq>;

	pinctrl-names = "default";
	pinctrl-0 = <&sdmmc_bus4 &sdmmc_clk &sdmmc_cmd &sdmmc_det>;

	vmmc-supply = <&vcc_3v3>;
	vqmmc-supply = <&vccio_sd_s0>;

	bus-width = <4>;
	max-frequency = <50000000>;
	drv-type = <2>;
	cap-sd-highspeed;
	sd-uhs-sdr50;
	sd-uhs-sdr104;
	keep-power-in-suspend;
	enable-sdio-wakeup;
	cap-sdio-irq;
	non-removable;
	no-mmc;
	no-sd;

	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	qca_wifi: qca-wifi@1 {
		reg = <1>;
		compatible = "qcom,ath10k";
	};
};

&pinctrl {
	wireless {
		wlan_en_pin: wlan-en-pin {
			rockchip,pins = <4 RK_PA5 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
};

#endif // defined(ATB_MUX_WIFI)

&uart1 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart1m1_xfer &uart1m1_ctsn &uart1m1_rtsn>;
	uart-has-rtscts;
	status = "okay";

	// A1 - 8223A-SR
	bluetooth {
		compatible = "qcom,qca9377-bt";
		max-speed = <2000000>;
		clocks = <&rtc_clock>;
		clock-names = "rtc_clock";
	};
};
