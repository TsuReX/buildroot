
//D14   //GMAC0 PHY //RTL8211FI
&gmac0 {
	status = "okay";
	// Use rgmii-id mode, use both delays
	phy-mode = "rgmii-id";
	clock_in_out = "input";

	// PHY hardware reset, active low
	snps,reset-gpio = <&gpio3 RK_PB2 GPIO_ACTIVE_LOW>;
	snps,reset-active-low;

	// Reset time is 20ms, 100ms for rtl8211f
	snps,reset-delays-us = <0 20000 100000>;

	pinctrl-names = "default";
	pinctrl-0 = <&gmac0_miim
			&gmac0_tx_bus2
			&gmac0_rx_bus2
			&gmac0_rgmii_clk
			&gmac0_rgmii_bus
			&gmac0_clkinout
			&rgmii_phy0_reset_pin>;

	tx_delay = <0x25>;
	rx_delay = <0x25>; 

	phy-handle = <&rgmii_phy0>;
};

&mdio0 {
	rgmii_phy0: phy@1 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <0x1>;
	};
};

//D15   //GMAC1 PHY //RTL8211FI
&gmac1 {
	status = "okay";
	// Use rgmii-id mode, use both delays
	phy-mode = "rgmii-id";
	clock_in_out = "input";

	// PHY hardware reset, active low
	snps,reset-gpio = <&gpio3 RK_PB7 GPIO_ACTIVE_LOW>;
	snps,reset-active-low;

	// Reset time is 20ms, 100ms for rtl8211f
	snps,reset-delays-us = <0 20000 100000>;

	pinctrl-names = "default";
	pinctrl-0 = <&gmac1_miim
			&gmac1_tx_bus2
			&gmac1_rx_bus2
			&gmac1_rgmii_clk
			&gmac1_rgmii_bus
			&gmac1_clkinout
			&rgmii_phy1_reset_pin>;

	tx_delay = <0x25>;
	rx_delay = <0x25>; 

	phy-handle = <&rgmii_phy1>;
};

&mdio1 {
	rgmii_phy1: phy@1 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <0x1>;
	};
};

&pinctrl {
	ethernet {
		rgmii_phy0_reset_pin: rgmii-phy0-reset-pin {
			rockchip,pins = <3 RK_PB2 RK_FUNC_GPIO &pcfg_pull_none>;
		};
		rgmii_phy1_reset_pin: rgmii-phy1-reset-pin {
			rockchip,pins = <3 RK_PB7 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
};
