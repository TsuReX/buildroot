*/
//=============================================================================
//  SDIO SD eMMC
//=============================================================================
//D11   //eMMC
//eMMC_MUX_ENA

&sdhci {
	bus-width = <8>;
	no-sdio;
	no-sd;
	non-removable;
	max-frequency = <200000000>;
	mmc-hs400-1_8v;
	mmc-hs400-enhanced-strobe;
	status = "okay";
};

//SD Card
&sdmmc {
	max-frequency = <200000000>;
	no-sdio;
	no-mmc;
	bus-width = <4>;
	cap-mmc-highspeed;
	cap-sd-highspeed;
	disable-wp;
	sd-uhs-sdr104;
	vmmc-supply = <&vcc_3v3>;
	vqmmc-supply = <&vccio_sd_s0>;
	pinctrl-names = "default";
	pinctrl-0 = <&sdmmc_bus4 &sdmmc_clk &sdmmc_cmd &sdmmc_det>;
	status = "okay";
};

//=============================================================================
//  //ETHERNET (GMAC)
//=============================================================================
//D14   //GMAC0 PHY //RTL8211FI
&gmac0 {
	status = "okay";
	// Use rgmii-id mode, use both delays
	phy-mode = "rgmii-id";
	clock_in_out = "input";

	// PHY hardware reset, active low
	snps,reset-gpio = <&gpio3 RK_PB2 GPIO_ACTIVE_LOW>;
	snps,reset-active-low;

	// Reset time is 20ms, 100ms for rtl8211f
	snps,reset-delays-us = <0 20000 100000>;

	pinctrl-names = "default";
	pinctrl-0 = <&gmac0_miim
			&gmac0_tx_bus2
			&gmac0_rx_bus2
			&gmac0_rgmii_clk
			&gmac0_rgmii_bus
			&gmac0_clkinout
			&rgmii_phy0_reset_pin>;

	tx_delay = <0x25>;
	rx_delay = <0x25>; 

	phy-handle = <&rgmii_phy0>;
};

&mdio0 {
	rgmii_phy0: phy@1 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <0x1>;
	};
};

//D15   //GMAC1 PHY //RTL8211FI
&gmac1 {
	status = "okay";
	// Use rgmii-id mode, use both delays
	phy-mode = "rgmii-id";
	clock_in_out = "input";

	// PHY hardware reset, active low
	snps,reset-gpio = <&gpio3 RK_PB7 GPIO_ACTIVE_LOW>;
	snps,reset-active-low;

	// Reset time is 20ms, 100ms for rtl8211f
	snps,reset-delays-us = <0 20000 100000>;

	pinctrl-names = "default";
	pinctrl-0 = <&gmac1_miim
			&gmac1_tx_bus2
			&gmac1_rx_bus2
			&gmac1_rgmii_clk
			&gmac1_rgmii_bus
			&gmac1_clkinout
			&rgmii_phy1_reset_pin>;

	tx_delay = <0x25>;
	rx_delay = <0x25>; 

	phy-handle = <&rgmii_phy1>;
};

&mdio1 {
	rgmii_phy1: phy@1 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <0x1>;
	};
};

//=============================================================================
//  PINCTL
//=============================================================================
&pinctrl {
	ethernet {
		rgmii_phy0_reset_pin: rgmii-phy0-reset-pin {
			rockchip,pins = <3 RK_PB2 RK_FUNC_GPIO &pcfg_pull_none>;
		};
		rgmii_phy1_reset_pin: rgmii-phy1-reset-pin {
			rockchip,pins = <3 RK_PB7 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
	
	watchdog{
		watchdog_gpio_wdi{
			rockchip,pins = <4 RK_PA7 RK_FUNC_GPIO &pcfg_pull_none>;
		};
		watchdog_disable{
			rockchip,pins = <4 RK_PA6 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
	
	sdio-pwrseq {
		wlan_en_pin: wlan-en-pin {
			rockchip,pins = <4 RK_PA5 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
	
	pcie {
		//miniPCIe_RST_
		minipcie_rst_pin: minipcie_rst_pin {
			rockchip,pins = <4 RK_PC1 RK_FUNC_GPIO &pcfg_pull_none>;
		};
		//PCIe_RST_
		pcie_rst_pin: pcie_rst_pin {
			rockchip,pins = <1 RK_PB2 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
};

&rng {
	status = "okay";
};

//=============================================================================
//  //PCIE SATA
//============================================================================
//-----------------------------------------------------------------------------
//          PCIe20_0 muxing with SATA30_0
//pcie2x1l2 is PCIe20_0
//pcie2x1l2 can use COMBO_PHY_0_LANE0 only

//SATA_0_
&combphy0_ps {
	status = "okay";
};
&pcie2x1l2 {
	status = "disabled";
};
&sata0 {
	status = "okay";
};
//-----------------------------------------------------------------------------
//          PCIe20_1 muxing with SATA30_1
//is PCIe20_1
//pcie2x1l0 can use PCIE30_PORT0_LANE1 or COMBO_PHY_1_LANE0. Controlled by pcie30-phymode.

//	This controller is phy for sata1 or pcie2x1l0 controllers
&combphy1_ps {
	status = "okay";
};
//SATA_1
//X20   M.2 Key B SATA
&sata1 {
	//	If this controller is enabled, pcie2x1l0 must be disabled
	status = "disabled";
	//status = "okay";
};

//PCIE
//X38 miniPCIe on COMBO_PHY_1_LANE0
//	If this controller is enabled, sata1 must be disabled
&pcie2x1l0 {
//M2kB_PCIE_RSTn
	vpcie3v3-supply = <&vcc_3v3>;			
	//status = "disabled";
	status = "okay";
};

//-----------------------------------------------------------------------------
//          PCIe20_2 muxing with SATA30_2 and USB30_2 (usbhost3_0)
//pcie2x1l1 is PCIe20_2
//pcie2x1l1 can use PCIE30_PORT1_LANE1 or COMBO_PHY_2_LANE0. Controlled by pcie30-phymode.

//PCIe20_2 is disabled now
&combphy2_psu {
	status = "okay";
};
&usbhost3_0 {
	status = "disabled";
};
&usbhost_dwc3_0 {
	status = "disabled";
};
&sata2 {
	status = "disabled";
};

//PCIe20_2
//OUT Lane D on PCIE30_PORT1_LANE1  
//x21 MiniPCIe
&pcie2x1l1 {
	//miniPCIe_RST_
	//reset-gpios = <&gpio4 RK_PC1 GPIO_ACTIVE_LOW>;
	//pinctrl-names = "default";
	//pinctrl-0 = <&minipcie_rst_pin>;
	vpcie3v3-supply = <&vcc_3v3>;	
	status = "okay";
};

//=============================================================================
//  //PCIe3X4   //PCIE30_PORT0  //Subsystem Protocol Link Mapping
//  //PCIe_RST_
//=============================================================================
&pcie30phy {
//PHY_MODE_PCIE_AGGREGATION 4	/* PCIe3x4 */
//PHY_MODE_PCIE_NANBNB	0	/* P1:PCIe3x2  +  P0:PCIe3x2 */
//PHY_MODE_PCIE_NANBBI	1	/* P1:PCIe3x2  +  P0:PCIe3x1*2 */
//PHY_MODE_PCIE_NABINB	2	/* P1:PCIe3x1*2 + P0:PCIe3x2 */
//PHY_MODE_PCIE_NABIBI	3	/* P1:PCIe3x1*2 + P0:PCIe3x1*2 */
	rockchip,pcie30-phymode = <PHY_MODE_PCIE_AGGREGATION>;   
	status = "okay";
};

//X22 pcie slot
&pcie3x4 {
	//CHECK_IT  //Set this
	//PCIe_RST_
	//reset-gpios = <&gpio1 RK_PB2 GPIO_ACTIVE_HIGH>;
	//pinctrl-names = "default";
	//pinctrl-0 = <&pcie_rst_pin>;
	vpcie3v3-supply = <&vcc_3v3>;
	status = "okay";
};
//=============================================================================
//  //PCIe3X2   //PCIE30_PORT1  //Subsystem Protocol Link Mapping
//  //PCIe_RST_
//=============================================================================
&pcie3x2 {
	vpcie3v3-supply = <&vcc_3v3>;
	status = "disabled";
};

