/dts-v1/;

#include <dt-bindings/usb/pd.h>
#include "imx8mp.dtsi"
#include "imx8mp-pad-ctrl.h"

/ {
	compatible = "atb,imx8mp-sodimm", "fsl,imx8mp";

	aliases {
		ethernet0 = &eqos;
		ethernet1 = &fec;
	};

	/delete-node/ memory@40000000;

	reserved-memory {
		/* CMA region is configured by kernel command line as cma=<size>M */
		/delete-node/ linux,cma;
	};
};

&A53_0 {
	cpu-supply = <&buck2>;
};

&A53_1 {
	cpu-supply = <&buck2>;
};

&A53_2 {
	cpu-supply = <&buck2>;
};

&A53_3 {
	cpu-supply = <&buck2>;
};

&eqos {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_eqos>;
	phy-mode = "rgmii";
	phy-handle = <&ethphy0>;
	status = "okay";

	mdio {
		compatible = "snps,dwmac-mdio";
		#address-cells = <1>;
		#size-cells = <0>;

		ethphy0: ethernet-phy@1 {
			compatible = "ethernet-phy-ieee802.3-c22";
			reg = <1>;
			rtl821x,clkout-enable;
			rtl821x,aldps-disable;
			eee-broken-1000t;
		};
	};
};

&i2c1 {
	clock-frequency = <400000>;
	pinctrl-names = "default", "gpio";
	pinctrl-0 = <&pinctrl_i2c1>;
	pinctrl-1 = <&pinctrl_i2c1_gpio>;
	scl-gpios = <&gpio2 6 GPIO_ACTIVE_HIGH>;
	sda-gpios = <&gpio2 7 GPIO_ACTIVE_HIGH>;
	status = "okay";

	pmic: pca9450@25 {
		reg = <0x25>;
		compatible = "nxp,pca9450c";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_pmic>;
		interrupt-parent = <&gpio1>;
		interrupts = <4 GPIO_ACTIVE_LOW>;
		status = "okay";

		regulators {
			#address-cells = <1>;
			#size-cells = <0>;

			buck1: BUCK1 {
				regulator-name = "BUCK1";
				regulator-min-microvolt = <600000>;
				regulator-max-microvolt = <2187500>;
				regulator-boot-on;
				regulator-always-on;
				regulator-ramp-delay = <3125>;
			};

			buck2: BUCK2 {
				regulator-name = "BUCK2";
				regulator-min-microvolt = <600000>;
				regulator-max-microvolt = <2187500>;
				regulator-boot-on;
				regulator-always-on;
				regulator-ramp-delay = <3125>;
				nxp,dvs-run-voltage = <950000>;
				nxp,dvs-standby-voltage = <850000>;
			};

			buck4: BUCK4 {
				regulator-name = "BUCK4";
				regulator-min-microvolt = <600000>;
				regulator-max-microvolt = <3400000>;
				regulator-boot-on;
				regulator-always-on;
			};

			buck5: BUCK5 {
				regulator-name = "BUCK5";
				regulator-min-microvolt = <600000>;
				regulator-max-microvolt = <3400000>;
				regulator-boot-on;
				regulator-always-on;
			};

			buck6: BUCK6 {
				regulator-name = "BUCK6";
				regulator-min-microvolt = <600000>;
				regulator-max-microvolt = <3400000>;
				regulator-boot-on;
				regulator-always-on;
			};

			ldo1: LDO1 {
				regulator-name = "LDO1";
				regulator-min-microvolt = <1600000>;
				regulator-max-microvolt = <3300000>;
				regulator-boot-on;
				regulator-always-on;
			};

			ldo2: LDO2 {
				regulator-name = "LDO2";
				regulator-min-microvolt = <800000>;
				regulator-max-microvolt = <1150000>;
				regulator-boot-on;
				regulator-always-on;
			};

			ldo3: LDO3 {
				regulator-name = "LDO3";
				regulator-min-microvolt = <800000>;
				regulator-max-microvolt = <3300000>;
				regulator-boot-on;
				regulator-always-on;
			};

			ldo4: LDO4 {
				regulator-name = "LDO4";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-always-on;
			};

			ldo5: LDO5 {
				regulator-name = "LDO5";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <3300000>;
			};
		};
	};
};

&sai3 {
	#sound-dai-cells = <0>;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_sai3>;
	assigned-clocks = <&clk IMX8MP_CLK_SAI3>;
	assigned-clock-parents = <&clk IMX8MP_AUDIO_PLL1_OUT>;
	assigned-clock-rates = <11536000>;
	clocks = <&audio_blk_ctrl IMX8MP_CLK_AUDIO_BLK_CTRL_SAI3_IPG>, <&clk IMX8MP_CLK_DUMMY>,
		 <&audio_blk_ctrl IMX8MP_CLK_AUDIO_BLK_CTRL_SAI3_MCLK1>, <&clk IMX8MP_CLK_DUMMY>,
		 <&clk IMX8MP_CLK_DUMMY>;
	clock-names = "bus", "mclk0", "mclk1", "mclk2", "mclk3";
	fsl,sai-mclk-direction-output;
	status = "okay";
};

&sdma2 {
	status = "okay";
};

/* BT */
&uart3 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_uart3>, <&pinctrl_bt>;
	assigned-clocks = <&clk IMX8MP_CLK_UART3>;
	assigned-clock-parents = <&clk IMX8MP_SYS_PLL1_80M>;
	uart-has-rtscts;
	status = "okay";
};

/* WIFI */
&usdhc1 {
	#address-cells = <1>;
	#size-cells = <0>;
	pinctrl-names = "default", "state_100mhz", "state_200mhz";
	pinctrl-0 = <&pinctrl_usdhc1>, <&pinctrl_wifi>;
	pinctrl-1 = <&pinctrl_usdhc1_100mhz>, <&pinctrl_wifi>;
	pinctrl-2 = <&pinctrl_usdhc1_200mhz>, <&pinctrl_wifi>;
	bus-width = <4>;
	non-removable;
	keep-power-in-suspend;
	status = "okay";

	brcmf: bcrmf@1 {
		reg = <1>;
		compatible = "brcm,bcm4329-fmac";
		laird,regdomain = "US";
	};
};

/* eMMC */
&usdhc3 {
	pinctrl-names = "default", "state_100mhz", "state_200mhz";
	pinctrl-0 = <&pinctrl_usdhc3>;
	pinctrl-1 = <&pinctrl_usdhc3_100mhz>;
	pinctrl-2 = <&pinctrl_usdhc3_200mhz>;
	bus-width = <8>;
	non-removable;
	status = "okay";
};

&vpu_g1 {
	status = "okay";
};

&vpu_g2 {
	status = "okay";
};

&vpu_vc8000e {
	status = "okay";
};

&vpu_v4l2 {
	status = "disabled";
};

&gpu_3d {
	status = "okay";
};

&gpu_2d {
	status = "okay";
};

&ml_vipsi {
	status = "okay";
};

&mix_gpu_ml {
	status = "okay";
};

&snvs_rtc {
	status = "disabled";
};

&caam_snvs {
	status = "disabled";
};

&snvs_pwrkey {
	status = "okay";
};

&iomuxc {
	pinctrl_eqos: eqosgrp {
		fsl,pins = <
			MX8MP_IOMUXC_ENET_MDC__ENET_QOS_MDC				(PAD_DSE_X4) /* 0x2 */
			MX8MP_IOMUXC_ENET_MDIO__ENET_QOS_MDIO				(PAD_DSE_X4)
			MX8MP_IOMUXC_ENET_RD0__ENET_QOS_RGMII_RD0			(PAD_INPUT_SCHMITT | PAD_FAST_SLEW_RATE) /* 0x90 */
			MX8MP_IOMUXC_ENET_RD1__ENET_QOS_RGMII_RD1			(PAD_INPUT_SCHMITT | PAD_FAST_SLEW_RATE)
			MX8MP_IOMUXC_ENET_RD2__ENET_QOS_RGMII_RD2			(PAD_INPUT_SCHMITT | PAD_FAST_SLEW_RATE)
			MX8MP_IOMUXC_ENET_RD3__ENET_QOS_RGMII_RD3			(PAD_INPUT_SCHMITT | PAD_FAST_SLEW_RATE)
			MX8MP_IOMUXC_ENET_RXC__CCM_ENET_QOS_CLOCK_GENERATE_RX_CLK	(PAD_INPUT_SCHMITT | PAD_FAST_SLEW_RATE)
			MX8MP_IOMUXC_ENET_RX_CTL__ENET_QOS_RGMII_RX_CTL			(PAD_INPUT_SCHMITT | PAD_FAST_SLEW_RATE)
			MX8MP_IOMUXC_ENET_TD0__ENET_QOS_RGMII_TD0			(PAD_FAST_SLEW_RATE | PAD_DSE_X6) /* 0x16 */
			MX8MP_IOMUXC_ENET_TD1__ENET_QOS_RGMII_TD1			(PAD_FAST_SLEW_RATE | PAD_DSE_X6)
			MX8MP_IOMUXC_ENET_TD2__ENET_QOS_RGMII_TD2			(PAD_FAST_SLEW_RATE | PAD_DSE_X6)
			MX8MP_IOMUXC_ENET_TD3__ENET_QOS_RGMII_TD3			(PAD_FAST_SLEW_RATE | PAD_DSE_X6)
			MX8MP_IOMUXC_ENET_TX_CTL__ENET_QOS_RGMII_TX_CTL			(PAD_FAST_SLEW_RATE | PAD_DSE_X6)
			MX8MP_IOMUXC_ENET_TXC__CCM_ENET_QOS_CLOCK_GENERATE_TX_CLK	(PAD_FAST_SLEW_RATE | PAD_DSE_X6)
		>;
	};

	pinctrl_i2c1: i2c1grp {
		fsl,pins = <
			MX8MP_IOMUXC_I2C1_SCL__I2C1_SCL				(0x40000000 + PAD_PULL_ENABLE | PAD_INPUT_SCHMITT | PAD_WEAK_PULL_UP | PAD_DSE_X4) /* 0x400001c2 */
			MX8MP_IOMUXC_I2C1_SDA__I2C1_SDA				(0x40000000 + PAD_PULL_ENABLE | PAD_INPUT_SCHMITT | PAD_WEAK_PULL_UP | PAD_DSE_X4)
		>;
	};

	pinctrl_i2c1_gpio: i2c1gpiogrp {
		fsl,pins = <
			MX8MP_IOMUXC_I2C1_SCL__GPIO5_IO14				 (PAD_PULL_ENABLE | PAD_INPUT_SCHMITT | PAD_WEAK_PULL_UP) /* 0x1c0 */
			MX8MP_IOMUXC_I2C1_SDA__GPIO5_IO15				 (PAD_PULL_ENABLE | PAD_INPUT_SCHMITT | PAD_WEAK_PULL_UP)
		>;
	};

	pinctrl_pmic: pmicgrp {
		fsl,pins = <
			MX8MP_IOMUXC_GPIO1_IO04__GPIO1_IO04				(PAD_PULL_ENABLE | PAD_INPUT_SCHMITT | PAD_WEAK_PULL_UP)
		>;
	};

	pinctrl_sai3: sai3grp {
		fsl,pins = <
			MX8MP_IOMUXC_SAI3_TXFS__AUDIOMIX_SAI3_TX_SYNC			(PAD_INPUT_SCHMITT | PAD_WEAK_PULL_UP |PAD_FAST_SLEW_RATE | PAD_DSE_X6) /* 0xd6 */
			MX8MP_IOMUXC_SAI3_TXC__AUDIOMIX_SAI3_TX_BCLK			(PAD_INPUT_SCHMITT | PAD_WEAK_PULL_UP |PAD_FAST_SLEW_RATE | PAD_DSE_X6)
			MX8MP_IOMUXC_SAI3_RXD__AUDIOMIX_SAI3_RX_DATA00			(PAD_INPUT_SCHMITT | PAD_WEAK_PULL_UP |PAD_FAST_SLEW_RATE | PAD_DSE_X6)
			MX8MP_IOMUXC_SAI3_TXD__AUDIOMIX_SAI3_TX_DATA00			(PAD_INPUT_SCHMITT | PAD_WEAK_PULL_UP |PAD_FAST_SLEW_RATE | PAD_DSE_X6)
			MX8MP_IOMUXC_SAI3_MCLK__AUDIOMIX_SAI3_MCLK			(PAD_INPUT_SCHMITT | PAD_WEAK_PULL_UP |PAD_FAST_SLEW_RATE | PAD_DSE_X6)
			MX8MP_IOMUXC_SAI3_RXFS__AUDIOMIX_SAI3_RX_SYNC			(PAD_INPUT_SCHMITT | PAD_WEAK_PULL_UP |PAD_FAST_SLEW_RATE | PAD_DSE_X6)
			MX8MP_IOMUXC_SAI3_RXC__AUDIOMIX_SAI3_RX_BCLK			(PAD_INPUT_SCHMITT | PAD_WEAK_PULL_UP |PAD_FAST_SLEW_RATE | PAD_DSE_X6)
		>;
	};

	pinctrl_usdhc1: usdhc1grp {
		fsl,pins = <
			MX8MP_IOMUXC_SD1_CLK__USDHC1_CLK				(PAD_PULL_ENABLE | PAD_INPUT_SCHMITT | PAD_FAST_SLEW_RATE)
			MX8MP_IOMUXC_SD1_CMD__USDHC1_CMD				(PAD_PULL_ENABLE | PAD_INPUT_SCHMITT | PAD_WEAK_PULL_UP |PAD_FAST_SLEW_RATE | PAD_DSE_X2)
			MX8MP_IOMUXC_SD1_DATA0__USDHC1_DATA0				(PAD_PULL_ENABLE | PAD_INPUT_SCHMITT | PAD_WEAK_PULL_UP |PAD_FAST_SLEW_RATE | PAD_DSE_X2)
			MX8MP_IOMUXC_SD1_DATA1__USDHC1_DATA1				(PAD_PULL_ENABLE | PAD_INPUT_SCHMITT | PAD_WEAK_PULL_UP |PAD_FAST_SLEW_RATE | PAD_DSE_X2)
			MX8MP_IOMUXC_SD1_DATA2__USDHC1_DATA2				(PAD_PULL_ENABLE | PAD_INPUT_SCHMITT | PAD_WEAK_PULL_UP |PAD_FAST_SLEW_RATE | PAD_DSE_X2)
			MX8MP_IOMUXC_SD1_DATA3__USDHC1_DATA3				(PAD_PULL_ENABLE | PAD_INPUT_SCHMITT | PAD_WEAK_PULL_UP |PAD_FAST_SLEW_RATE | PAD_DSE_X2)
		>;
	};

	pinctrl_usdhc1_100mhz: usdhc1grp-100mhz {
		fsl,pins = <
			MX8MP_IOMUXC_SD1_CLK__USDHC1_CLK				(PAD_PULL_ENABLE | PAD_INPUT_SCHMITT | PAD_FAST_SLEW_RATE | PAD_DSE_X2) /* 0x194 */
			MX8MP_IOMUXC_SD1_CMD__USDHC1_CMD				(PAD_PULL_ENABLE | PAD_INPUT_SCHMITT | PAD_WEAK_PULL_UP |PAD_FAST_SLEW_RATE | PAD_DSE_X2)
			MX8MP_IOMUXC_SD1_DATA0__USDHC1_DATA0				(PAD_PULL_ENABLE | PAD_INPUT_SCHMITT | PAD_WEAK_PULL_UP |PAD_FAST_SLEW_RATE | PAD_DSE_X2)
			MX8MP_IOMUXC_SD1_DATA1__USDHC1_DATA1				(PAD_PULL_ENABLE | PAD_INPUT_SCHMITT | PAD_WEAK_PULL_UP |PAD_FAST_SLEW_RATE | PAD_DSE_X2)
			MX8MP_IOMUXC_SD1_DATA2__USDHC1_DATA2				(PAD_PULL_ENABLE | PAD_INPUT_SCHMITT | PAD_WEAK_PULL_UP |PAD_FAST_SLEW_RATE | PAD_DSE_X2)
			MX8MP_IOMUXC_SD1_DATA3__USDHC1_DATA3				(PAD_PULL_ENABLE | PAD_INPUT_SCHMITT | PAD_WEAK_PULL_UP |PAD_FAST_SLEW_RATE | PAD_DSE_X2)
		>;
	};

	pinctrl_usdhc1_200mhz: usdhc1grp-200mhz {
		fsl,pins = <
			MX8MP_IOMUXC_SD1_CLK__USDHC1_CLK				(PAD_PULL_ENABLE | PAD_INPUT_SCHMITT | PAD_FAST_SLEW_RATE | PAD_DSE_X6) /* 0x196 */
			MX8MP_IOMUXC_SD1_CMD__USDHC1_CMD				(PAD_PULL_ENABLE | PAD_INPUT_SCHMITT | PAD_WEAK_PULL_UP |PAD_FAST_SLEW_RATE | PAD_DSE_X6) /* 0x1d6 */
			MX8MP_IOMUXC_SD1_DATA0__USDHC1_DATA0				(PAD_PULL_ENABLE | PAD_INPUT_SCHMITT | PAD_WEAK_PULL_UP |PAD_FAST_SLEW_RATE | PAD_DSE_X6)
			MX8MP_IOMUXC_SD1_DATA1__USDHC1_DATA1				(PAD_PULL_ENABLE | PAD_INPUT_SCHMITT | PAD_WEAK_PULL_UP |PAD_FAST_SLEW_RATE | PAD_DSE_X6)
			MX8MP_IOMUXC_SD1_DATA2__USDHC1_DATA2				(PAD_PULL_ENABLE | PAD_INPUT_SCHMITT | PAD_WEAK_PULL_UP |PAD_FAST_SLEW_RATE | PAD_DSE_X6)
			MX8MP_IOMUXC_SD1_DATA3__USDHC1_DATA3				(PAD_PULL_ENABLE | PAD_INPUT_SCHMITT | PAD_WEAK_PULL_UP |PAD_FAST_SLEW_RATE | PAD_DSE_X6)
		>;
	};

	pinctrl_usdhc3: usdhc3grp {
		fsl,pins = <
			MX8MP_IOMUXC_NAND_WE_B__USDHC3_CLK				(PAD_PULL_ENABLE | PAD_INPUT_SCHMITT | PAD_FAST_SLEW_RATE) /* 0x190 */
			MX8MP_IOMUXC_NAND_WP_B__USDHC3_CMD				(PAD_PULL_ENABLE | PAD_INPUT_SCHMITT | PAD_WEAK_PULL_UP |PAD_FAST_SLEW_RATE | PAD_DSE_X2) /* 0x1d0 */
			MX8MP_IOMUXC_NAND_DATA04__USDHC3_DATA0				(PAD_PULL_ENABLE | PAD_INPUT_SCHMITT | PAD_WEAK_PULL_UP |PAD_FAST_SLEW_RATE | PAD_DSE_X2)
			MX8MP_IOMUXC_NAND_DATA05__USDHC3_DATA1				(PAD_PULL_ENABLE | PAD_INPUT_SCHMITT | PAD_WEAK_PULL_UP |PAD_FAST_SLEW_RATE | PAD_DSE_X2)
			MX8MP_IOMUXC_NAND_DATA06__USDHC3_DATA2				(PAD_PULL_ENABLE | PAD_INPUT_SCHMITT | PAD_WEAK_PULL_UP |PAD_FAST_SLEW_RATE | PAD_DSE_X2)
			MX8MP_IOMUXC_NAND_DATA07__USDHC3_DATA3				(PAD_PULL_ENABLE | PAD_INPUT_SCHMITT | PAD_WEAK_PULL_UP |PAD_FAST_SLEW_RATE | PAD_DSE_X2)
			MX8MP_IOMUXC_NAND_RE_B__USDHC3_DATA4				(PAD_PULL_ENABLE | PAD_INPUT_SCHMITT | PAD_WEAK_PULL_UP |PAD_FAST_SLEW_RATE | PAD_DSE_X2)
			MX8MP_IOMUXC_NAND_CE2_B__USDHC3_DATA5				(PAD_PULL_ENABLE | PAD_INPUT_SCHMITT | PAD_WEAK_PULL_UP |PAD_FAST_SLEW_RATE | PAD_DSE_X2)
			MX8MP_IOMUXC_NAND_CE3_B__USDHC3_DATA6				(PAD_PULL_ENABLE | PAD_INPUT_SCHMITT | PAD_WEAK_PULL_UP |PAD_FAST_SLEW_RATE | PAD_DSE_X2)
			MX8MP_IOMUXC_NAND_CLE__USDHC3_DATA7				(PAD_PULL_ENABLE | PAD_INPUT_SCHMITT | PAD_WEAK_PULL_UP |PAD_FAST_SLEW_RATE | PAD_DSE_X2)
			MX8MP_IOMUXC_NAND_CE1_B__USDHC3_STROBE				(PAD_PULL_ENABLE | PAD_INPUT_SCHMITT | PAD_FAST_SLEW_RATE)
		>;
	};

	pinctrl_usdhc3_100mhz: usdhc3grp-100mhz {
		fsl,pins = <
			MX8MP_IOMUXC_NAND_WE_B__USDHC3_CLK				(PAD_PULL_ENABLE | PAD_INPUT_SCHMITT | PAD_FAST_SLEW_RATE | PAD_DSE_X2)
			MX8MP_IOMUXC_NAND_WP_B__USDHC3_CMD				(PAD_PULL_ENABLE | PAD_INPUT_SCHMITT | PAD_WEAK_PULL_UP |PAD_FAST_SLEW_RATE | PAD_DSE_X2)
			MX8MP_IOMUXC_NAND_DATA04__USDHC3_DATA0				(PAD_PULL_ENABLE | PAD_INPUT_SCHMITT | PAD_WEAK_PULL_UP |PAD_FAST_SLEW_RATE | PAD_DSE_X2)
			MX8MP_IOMUXC_NAND_DATA05__USDHC3_DATA1				(PAD_PULL_ENABLE | PAD_INPUT_SCHMITT | PAD_WEAK_PULL_UP |PAD_FAST_SLEW_RATE | PAD_DSE_X2)
			MX8MP_IOMUXC_NAND_DATA06__USDHC3_DATA2				(PAD_PULL_ENABLE | PAD_INPUT_SCHMITT | PAD_WEAK_PULL_UP |PAD_FAST_SLEW_RATE | PAD_DSE_X2)
			MX8MP_IOMUXC_NAND_DATA07__USDHC3_DATA3				(PAD_PULL_ENABLE | PAD_INPUT_SCHMITT | PAD_WEAK_PULL_UP |PAD_FAST_SLEW_RATE | PAD_DSE_X2)
			MX8MP_IOMUXC_NAND_RE_B__USDHC3_DATA4				(PAD_PULL_ENABLE | PAD_INPUT_SCHMITT | PAD_WEAK_PULL_UP |PAD_FAST_SLEW_RATE | PAD_DSE_X2)
			MX8MP_IOMUXC_NAND_CE2_B__USDHC3_DATA5				(PAD_PULL_ENABLE | PAD_INPUT_SCHMITT | PAD_WEAK_PULL_UP |PAD_FAST_SLEW_RATE | PAD_DSE_X2)
			MX8MP_IOMUXC_NAND_CE3_B__USDHC3_DATA6				(PAD_PULL_ENABLE | PAD_INPUT_SCHMITT | PAD_WEAK_PULL_UP |PAD_FAST_SLEW_RATE | PAD_DSE_X2)
			MX8MP_IOMUXC_NAND_CLE__USDHC3_DATA7				(PAD_PULL_ENABLE | PAD_INPUT_SCHMITT | PAD_WEAK_PULL_UP |PAD_FAST_SLEW_RATE | PAD_DSE_X2)
			MX8MP_IOMUXC_NAND_CE1_B__USDHC3_STROBE				(PAD_PULL_ENABLE | PAD_INPUT_SCHMITT | PAD_FAST_SLEW_RATE | PAD_DSE_X2)
		>;
	};

	pinctrl_usdhc3_200mhz: usdhc3grp-200mhz {
		fsl,pins = <
			MX8MP_IOMUXC_NAND_WE_B__USDHC3_CLK				(PAD_PULL_ENABLE | PAD_INPUT_SCHMITT | PAD_WEAK_PULL_UP |PAD_FAST_SLEW_RATE | PAD_DSE_X6)
			MX8MP_IOMUXC_NAND_WP_B__USDHC3_CMD				(PAD_PULL_ENABLE | PAD_INPUT_SCHMITT | PAD_WEAK_PULL_UP |PAD_FAST_SLEW_RATE | PAD_DSE_X6)
			MX8MP_IOMUXC_NAND_DATA04__USDHC3_DATA0				(PAD_PULL_ENABLE | PAD_INPUT_SCHMITT | PAD_WEAK_PULL_UP |PAD_FAST_SLEW_RATE | PAD_DSE_X6)
			MX8MP_IOMUXC_NAND_DATA05__USDHC3_DATA1				(PAD_PULL_ENABLE | PAD_INPUT_SCHMITT | PAD_WEAK_PULL_UP |PAD_FAST_SLEW_RATE | PAD_DSE_X6)
			MX8MP_IOMUXC_NAND_DATA06__USDHC3_DATA2				(PAD_PULL_ENABLE | PAD_INPUT_SCHMITT | PAD_WEAK_PULL_UP |PAD_FAST_SLEW_RATE | PAD_DSE_X6)
			MX8MP_IOMUXC_NAND_DATA07__USDHC3_DATA3				(PAD_PULL_ENABLE | PAD_INPUT_SCHMITT | PAD_WEAK_PULL_UP |PAD_FAST_SLEW_RATE | PAD_DSE_X6)
			MX8MP_IOMUXC_NAND_RE_B__USDHC3_DATA4				(PAD_PULL_ENABLE | PAD_INPUT_SCHMITT | PAD_WEAK_PULL_UP |PAD_FAST_SLEW_RATE | PAD_DSE_X6)
			MX8MP_IOMUXC_NAND_CE2_B__USDHC3_DATA5				(PAD_PULL_ENABLE | PAD_INPUT_SCHMITT | PAD_WEAK_PULL_UP |PAD_FAST_SLEW_RATE | PAD_DSE_X6)
			MX8MP_IOMUXC_NAND_CE3_B__USDHC3_DATA6				(PAD_PULL_ENABLE | PAD_INPUT_SCHMITT | PAD_WEAK_PULL_UP |PAD_FAST_SLEW_RATE | PAD_DSE_X6)
			MX8MP_IOMUXC_NAND_CLE__USDHC3_DATA7				(PAD_PULL_ENABLE | PAD_INPUT_SCHMITT | PAD_WEAK_PULL_UP |PAD_FAST_SLEW_RATE | PAD_DSE_X6)
			MX8MP_IOMUXC_NAND_CE1_B__USDHC3_STROBE				(PAD_PULL_ENABLE | PAD_INPUT_SCHMITT | PAD_WEAK_PULL_UP |PAD_FAST_SLEW_RATE | PAD_DSE_X6)
		>;
	};

	pinctrl_wifi: wifigrp {
		fsl,pins = <
			/* WLAN_EN */
			MX8MP_IOMUXC_SD1_DATA4__GPIO2_IO06				(PAD_PULL_ENABLE | PAD_INPUT_SCHMITT | PAD_WEAK_PULL_UP | PAD_DSE_X4)
			/* WLAN_PDn */
			MX8MP_IOMUXC_SD1_DATA5__GPIO2_IO07				(PAD_PULL_ENABLE | PAD_INPUT_SCHMITT | PAD_WEAK_PULL_UP | PAD_DSE_X4)
		>;
	};

	pinctrl_bt: btgrp {
		fsl,pins = <
			/* BT_EN */
			MX8MP_IOMUXC_SD2_WP__GPIO2_IO20				  (PAD_INPUT_SCHMITT | PAD_WEAK_PULL_UP) /* 0xc0 */
		>;
	};

	pinctrl_uart3: uart3grp {
		fsl,pins = <
			/* BT_UART3_RX */
			MX8MP_IOMUXC_SD1_DATA7__UART3_DCE_RX				(PAD_PULL_ENABLE | PAD_WEAK_PULL_UP) /* 0x140 */
			/* BT_UART3_TX */
			MX8MP_IOMUXC_SD1_DATA6__UART3_DCE_TX				(PAD_PULL_ENABLE | PAD_WEAK_PULL_UP)
			/* BT_UART3_CTS */
			MX8MP_IOMUXC_SD1_STROBE__UART3_DCE_CTS				(PAD_PULL_ENABLE | PAD_WEAK_PULL_UP)
			/* BT_UART3_RTS */
			MX8MP_IOMUXC_SD1_RESET_B__UART3_DCE_RTS				(PAD_PULL_ENABLE | PAD_WEAK_PULL_UP)
		>;
	};

};
