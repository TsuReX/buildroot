diff --git a/arch/arm/dts/atb-rk3568j-mpc-usb-sata-pcie.dtsi b/arch/arm/dts/atb-rk3568j-mpc-usb-sata-pcie.dtsi
new file mode 100644
index 0000000000..7787ce586b
--- /dev/null
+++ b/arch/arm/dts/atb-rk3568j-mpc-usb-sata-pcie.dtsi
@@ -0,0 +1,220 @@
+/{
+
+/*
+	This is dummy regulator.
+	It is used to have ability to switch X14 between SATA and USB
+*/
+	m2_usb3_en: m2-usb3-en {
+		compatible = "regulator-fixed";
+		enable-active-high;
+		// M2_USB3.0_EN  PD(R161)
+		gpio = <&gpio1 RK_PB2 GPIO_ACTIVE_HIGH>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&m2_usb3_en_pin>;
+		regulator-name = "m2_usb3_en";
+		regulator-always-off;
+	};
+
+/*
+	This is dummy regulator.
+	It is used to have ability to supply X4 USB3 OTG with power
+*/
+	cpu_otg_usb_en: cpu-otg-usb-en {
+		compatible = "regulator-fixed";
+		enable-active-high;
+		// CPU_USB_OTG_EN -> D3, X4
+		gpio = <&gpio2 RK_PD6 GPIO_ACTIVE_HIGH>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&cpu_otg_usb_en_pin>;
+		regulator-name = "cpu_otg_usb_en";
+		regulator-always-on;
+	};
+
+/*
+	This is dummy regulator.
+	It is used to have ability to supply X5[0] USB2 HOST with power
+*/
+	usb2_h2_en: usb2-h2-en {
+		compatible = "regulator-fixed";
+		enable-active-high;
+		// CPU_USB_OTG_EN -> D4, X5[0]
+		gpio = <&gpio0 RK_PB0 GPIO_ACTIVE_HIGH>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&usb2_h2_en_pin>;
+		regulator-name = "usb2_h2_en";
+		regulator-always-on;
+	};
+
+/*
+	This is dummy regulator.
+	It is used to have ability to supply X5[1] USB2 HOST with power
+*/
+	usb2_h3_en: usb2-h3-en {
+		compatible = "regulator-fixed";
+		enable-active-high;
+		// CPU_USB_OTG_EN -> D4, X5[1]
+		gpio = <&gpio4 RK_PB7 GPIO_ACTIVE_HIGH>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&usb2_h3_en_pin>;
+		regulator-name = "usb2_h3_en";
+		regulator-always-on;
+	};
+};
+
+/*
+	USB2_HOST2
+*/
+
+/*
+	This controller is connected to X5 upper port
+*/
+&usb_host0_ehci {
+	status = "okay";
+};
+
+/*
+	This controller is connected to X5 upper port
+*/
+&usb_host0_ohci {
+	status = "okay";
+};
+
+&usb2phy0_host {
+	status = "okay";
+};
+
+&usb2phy0_otg {
+	status = "okay";
+};
+
+&usb2phy0 {
+	status = "okay";
+};
+
+/*
+	USB2_HOST3
+*/
+
+/*
+	This controller is connected to X5 lower port
+*/
+&usb_host1_ehci {
+	status = "okay";
+};
+
+/*
+	This controller is connected to X5 lower port
+*/
+&usb_host1_ohci {
+	status = "okay";
+};
+
+
+&usb2phy1_host {
+	status = "okay";
+};
+
+
+&usb2phy1_otg {
+	status = "okay";
+};
+
+&usb2phy1 {
+	status = "okay";
+};
+
+/*
+	USB3_OTG0 or SATA0
+*/
+// X4
+&usb_host0_xhci {
+	dr_mode = "host";
+	// If this controller is enabled, sata0 must be disabled
+	status = "okay";
+};
+
+&sata0 {
+//	If this controller is enabled, usb_host0_xhci must be disabled
+	status = "disabled";
+};
+
+&combphy0 {
+//	This controller is phy for usb_host0_xhci and sata0 controllers
+	status = "okay";
+};
+
+/*
+	USB3_HOST1 or SATA1
+*/
+
+/*
+	Signals form usb_host1_xhci and sata1 controllers controllers go through D12(switch)(EXT_SATA_EN) and D10(switch)(M2_USB3.0_EN) to X14(m.2B) or X16(SATA).
+	To supply X16(SATA) with signals from SATA1 it needs to set EXT_SATA_EN=1 (+3.3v) and disable usb_host1_xhci controller.
+	To supply X14(m.2B) with signals from SATA1 it needs to set EXT_SATA_EN=0 (GND) and disable usb_host1_xhci controller.
+	To supply X14(m.2B) with signals from USB3_HOS1 it needs to set EXT_SATA_EN=0 (GND), M2_USB3.0_EN=1 (+3.3v) and disable sata1 controller.
+	By defaults M2_USB3.0_EN signal is pulled down via R161 and EXT_SATA_EN signal is pulled down via R165 and can be pulled up via X17.
+*/
+&usb_host1_xhci {
+	// If this controller is enabled, sata1 must be disabled
+	status = "disabled";
+};
+
+// This board doesn't use this controller
+&sata1 {
+	// If this controller is enabled, usb_host1_xhci must be disabled
+	status = "okay";
+};
+
+// This controller is phy for usb_host1_xhci and sata1 controllers
+&combphy1 {
+	status = "okay";
+};
+
+/*
+	PCIE2x1 or SATA2
+*/
+
+// This board doesn't use this controller
+&pcie2x1 {
+	status = "disabled";
+};
+
+/*
+	SATA2 <-> D13 (switch) <-> X18 (m.2B/M)
+	he signals from SATA2 go through D13 in case if M2_CONFIG signal is set to low level (GND).
+	By default M2_CONFIG is set up to high level (+3.3v) via R177
+*/
+&sata2 {
+	status = "disabled";
+};
+
+// This controller is phy for pcie2x1 and sata2 controllers
+&combphy2 {
+	status = "disabled";
+};
+
+&pinctrl {
+	sata_usb {
+		m2_usb3_en_pin: m2-usb3-en-pin {
+			// M2_USB3.0_EN
+			rockchip,pins = <1 RK_PB2 RK_FUNC_GPIO &pcfg_pull_none>;
+		};
+	};
+
+	usb {
+		cpu_otg_usb_en_pin: cpu-otg-usb-en-pin{
+			// CPU_USB_OTG_EN, X4
+			rockchip,pins = <2 RK_PD6 RK_FUNC_GPIO &pcfg_pull_none>;
+		};
+
+		usb2_h2_en_pin: usb2-h2-en-pin{
+			// USB2_H2_EN, X5[0]
+			rockchip,pins = <0 RK_PB0 RK_FUNC_GPIO &pcfg_pull_none>;
+		};
+
+		usb2_h3_en_pin: usb2-h3-en-pin{
+			// USB2_H3_EN, X5[1]
+			rockchip,pins = <4 RK_PB7 RK_FUNC_GPIO &pcfg_pull_none>;
+		};
+	};
+};
diff --git a/arch/arm/dts/atb-rk3568j-mpc.dts b/arch/arm/dts/atb-rk3568j-mpc.dts
new file mode 100644
index 0000000000..3d5c9ae6fc
--- /dev/null
+++ b/arch/arm/dts/atb-rk3568j-mpc.dts
@@ -0,0 +1,29 @@
+
+/dts-v1/;
+
+#include "rk3568.dtsi"
+
+#include <dt-bindings/input/input.h>
+#include <dt-bindings/clock/rk3568-cru.h>
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/interrupt-controller/arm-gic.h>
+#include <dt-bindings/interrupt-controller/irq.h>
+#include <dt-bindings/pinctrl/rockchip.h>
+#include <dt-bindings/soc/rockchip,boot-mode.h>
+#include <dt-bindings/phy/phy.h>
+#include <dt-bindings/power/rk3568-power.h>
+
+#include "atb-rk3568j-mpc-u-boot.dtsi"
+#include "atb-rk3568j-mpc-ethernet.dtsi"
+#include "atb-rk3568j-mpc-usb-sata-pcie.dtsi"
+
+/ {
+	compatible = "atb,atb-rk3568j-mpc", "rockchip,rk3568";
+
+	model = "ATB-RK3568J-MPC";
+
+};
+
+&uart2 {
+	status = "okay";
+};
diff --git a/arch/arm/mach-rockchip/rk3568/Kconfig b/arch/arm/mach-rockchip/rk3568/Kconfig
index baa51349f4..6ca15b8256 100644
--- a/arch/arm/mach-rockchip/rk3568/Kconfig
+++ b/arch/arm/mach-rockchip/rk3568/Kconfig
@@ -27,6 +27,11 @@ config TARGET_QUARTZ64_RK3566
 	help
