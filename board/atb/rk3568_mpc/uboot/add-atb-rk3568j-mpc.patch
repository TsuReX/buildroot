diff --git a/arch/arm/dts/atb-rk3568j-mpc-ethernet.dtsi b/arch/arm/dts/atb-rk3568j-mpc-ethernet.dtsi
new file mode 100644
index 0000000000..2b87bfe806
--- /dev/null
+++ b/arch/arm/dts/atb-rk3568j-mpc-ethernet.dtsi
@@ -0,0 +1,152 @@
+
+&gmac0 {
+	phy-mode = "rgmii";
+	clock_in_out = "input";
+
+	assigned-clocks = <&cru SCLK_GMAC0_RX_TX>, <&cru SCLK_GMAC0>;
+	assigned-clock-parents = <&cru SCLK_GMAC0_RGMII_SPEED>;
+
+	pinctrl-names = "default";
+	pinctrl-0 = <	&gmac0_miim
+					&gmac0_tx_bus2
+					&gmac0_rx_bus2
+					&gmac0_rgmii_clk
+					&gmac0_rgmii_bus
+					&gmac0_clkinout
+					&rgmii_phy0_reset_pin>;
+/*
+	RGMII0_RST -> VT5(NMOS) -> RGMII0_RST_
+	0 -> 1
+	1 -> 0
+*/
+//	snps,reset-gpio = <&gpio4 RK_PB5 GPIO_ACTIVE_HIGH>;
+	snps,reset-active-high;
+
+	/* Reset time is 20ms, 100ms for rtl8211f */
+	snps,reset-delays-us = <0 20000 100000>;
+
+	tx_delay = <0x3c>;
+	rx_delay = <0x2f>;
+
+	phy-handle = <&rgmii_phy0>;
+	status = "okay";
+};
+
+&gmac0_clkinout{
+	bootph-all;
+};
+
+&gmac0_miim {
+	bootph-all;
+};
+
+&gmac0_rx_bus2 {
+	bootph-all;
+};
+
+&gmac0_tx_bus2 {
+	bootph-all;
+};
+
+&gmac0_rgmii_clk {
+	bootph-all;
+};
+
+&gmac0_rgmii_bus {
+	bootph-all;
+};
+
+&gmac1 {
+	phy-mode = "rgmii";
+	clock_in_out = "input";
+
+	assigned-clocks = <&cru SCLK_GMAC1_RX_TX>, <&cru SCLK_GMAC1>;
+	assigned-clock-parents = <&cru SCLK_GMAC1_RGMII_SPEED>;
+
+	pinctrl-names = "default";
+	pinctrl-0 = <	&gmac1m0_miim
+					&gmac1m0_tx_bus2
+					&gmac1m0_rx_bus2
+					&gmac1m0_rgmii_clk
+					&gmac1m0_rgmii_bus
+					&gmac1m0_clkinout
+					&rgmii_phy1_reset_pin>;
+/*
+	RGMII1_RST -> VT17(NMOS) -> RGMII1_RST_
+	0 -> 1
+	1 -> 0
+*/
+//	snps,reset-gpio = <&gpio4 RK_PB4 GPIO_ACTIVE_HIGH>;
+	snps,reset-active-high;
+
+	/* Reset time is 20ms, 100ms for rtl8211f */
+	snps,reset-delays-us = <0 20000 100000>;
+
+	tx_delay = <0x4f>;
+	rx_delay = <0x26>;
+
+	phy-handle = <&rgmii_phy1>;
+	status = "okay";
+};
+
+&gmac1m0_clkinout {
+	bootph-all;
+};
+
+&gmac1m0_miim {
+	bootph-all;
+};
+
+&gmac1m0_rx_bus2 {
+	bootph-all;
+};
+
+&gmac1m0_tx_bus2 {
+	bootph-all;
+};
+
+&gmac1m0_rgmii_clk {
+	bootph-all;
+};
+
+&gmac1m0_rgmii_bus {
+	bootph-all;
+};
+
+&mdio0 {
+	rgmii_phy0: ethernet-phy@1 {
+		compatible = "ethernet-phy-ieee802.3-c22";
+		reg = <0x1>;
+	};
+};
+
+&mdio1 {
+	rgmii_phy1: ethernet-phy@1 {
+		compatible = "ethernet-phy-ieee802.3-c22";
+		reg = <0x1>;
+	};
+};
+
+&pinctrl {
+	rgmii_phy0_reset {
+		rgmii_phy0_reset_pin: rgmii-phy0-reset-pin {
+/*
+			RGMII0_RST -> VT5 (NMOS) -> RGMII0_RST_
+			0 -> 1
+			1 -> 0
+*/
+			rockchip,pins = <4 RK_PB5 RK_FUNC_GPIO &pcfg_pull_none>;
+		};
+	};
+
+    rgmii_phy1_reset {
+		rgmii_phy1_reset_pin: rgmii-phy1-reset-pin {
+/*
+			RGMII1_RST -> VT7 (NMOS) -> RGMII1_RST_
+			0 -> 1
+			1 -> 0
+*/
+			rockchip,pins = <4 RK_PB4 RK_FUNC_GPIO &pcfg_pull_none>;
+		};
+	};
+};
diff --git a/arch/arm/dts/atb-rk3568j-mpc-images.dtsi b/arch/arm/dts/atb-rk3568j-mpc-images.dtsi
new file mode 100644
index 0000000000..eaddd85a47
--- /dev/null
+++ b/arch/arm/dts/atb-rk3568j-mpc-images.dtsi
@@ -0,0 +1,122 @@
+
+#include <config.h>
+
+/ {
+	binman: binman {
+		multiple-images;
+	};
+};
+
+
+&binman {
+	simple-bin {
+		filename = "idblock_uboot_atf_tee.bin";
+		pad-byte = <0xff>;
+
+		mkimage {
+			filename = "idbloader.img";
+			args = "-n", CONFIG_SYS_SOC, "-T", "rksd";
+			multiple-data-files;
+
+
+			rockchip-tpl {
+			};
+
+/*			u-boot-tpl {
+			};
+*/
+			u-boot-spl {
+				filename = "my-spl.bin";
+			};
+		};
+
+		fit: fit {
+			description = "FIT image for U-Boot with bl31 (TF-A)";
+			#address-cells = <1>;
+			fit,fdt-list = "of-list";
+			filename = "u-boot.itb";
+			fit,external-offset = <CONFIG_FIT_EXTERNAL_OFFSET>;
+			fit,align = <512>;
+			offset = <CONFIG_SPL_PAD_TO>;
+			images {
+				u-boot {
+					description = "U-Boot";
+					type = "standalone";
+					os = "U-Boot";
+					arch = "arm64";
+					compression = "none";
+					load = <CONFIG_TEXT_BASE>;
+					entry = <CONFIG_TEXT_BASE>;
+					u-boot-nodtb {
+					};
+					hash {
+						algo = "sha256";
+					};
+				};
+
+				@atf-SEQ {
+					fit,operation = "split-elf";
+					description = "ARM Trusted Firmware";
+					type = "firmware";
+					arch = "arm64";
+					os = "arm-trusted-firmware";
+					compression = "none";
+					fit,load;
+					fit,entry;
+					fit,data;
+
+					atf-bl31 {
+						atf-bl31-path = "456.bin";
+						filename = "my-atf.bin";
+					};
+
+					hash {
+						algo = "sha256";
+					};
+
+				};
+				@tee-SEQ {
+					fit,operation = "split-elf";
+					description = "TEE";
+					type = "tee";
+					arch = "arm64";
+					os = "tee";
+					compression = "none";
+					fit,load;
+					fit,entry;
+					fit,data;
+
+					tee-os {
+						optional;
+					};
+					hash {
+						algo = "sha256";
+					};
+				};
+
+				@fdt-SEQ {
+					description = "fdt-NAME";
+					compression = "none";
+					type = "flat_dt";
+
+					hash {
+						algo = "sha256";
+					};
+
+				};
+			};
+
+			configurations {
+				default = "@config-DEFAULT-SEQ";
+				@config-SEQ {
+					description = "NAME.dtb";
+					fdt = "fdt-SEQ";
+
+					fit,firmware = "atf-1", "u-boot";
+
+					fit,loadables;
+				};
+			};
+		};
+	};
+};
diff --git a/arch/arm/dts/atb-rk3568j-mpc-u-boot.dtsi b/arch/arm/dts/atb-rk3568j-mpc-u-boot.dtsi
new file mode 100644
